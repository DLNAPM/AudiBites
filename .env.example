# =========================================================
# AudiBites Environment Configuration
# =========================================================

# Primary Gemini API Key (used by both Express backend and Vite build)
GEMINI_API_KEY=

# Alternative key name aliases (all are supported automatically)
API_KEY=
VITE_GEMINI_API_KEY=
VITE_API_KEY=

# Server Port (optional, defaults to 3000 or Render's assigned $PORT)
PORT=3000

# Node Environment
NODE_ENV=production
